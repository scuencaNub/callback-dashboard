### Get Queue Configuration
# Returns: { "items": [...], "count": number }
# Each item contains: queue_id, queue_name, max_retry_attempts, retry_attempt_interval, 
# stop_on_voicemail, business_hours_enable, stop_time_asap_enable, start_time_asap, 
# stop_time_asap, ewt_max_minutes_enable, ewt_max_minutes, allowed_callback_type, 
# allow_only_next_day, business_hours_custom_message, phone_number_for_client, 
# outbound_phone_number, flow_arn
GET https://g6uscg6485.execute-api.us-east-1.amazonaws.com/Prod/queue-configurations
Accept: application/json



